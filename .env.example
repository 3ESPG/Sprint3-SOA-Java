# Copie para .env (não versionado) e ajuste. Carregue com:  set -a; source .env; set +a

# Obrigatório – segredo HMAC do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Opcional – validade do token (padrão 1h)
JWT_EXPIRATION=1h

# Perfil: dev (H2 + data.sql) ou prod (Oracle)
SPRING_PROFILES_ACTIVE=dev

# Somente para o perfil prod
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USERNAME=rm000000
DB_PASSWORD=sua-senha
# always na 1ª execução para carregar os dados de exemplo no Oracle (idempotente)
DB_SEED=never

# Opcionais
LEAD_SCORE_LIMITE=0.70
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
